# Copy this file to .env and adjust as needed.

# PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lead_intelligence

# For quick local testing without installing Postgres, you can instead use:
# DATABASE_URL=sqlite:///./lead_intelligence.db

# Comma-separated list of origins allowed to call the API (the frontend dev server, etc.)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
